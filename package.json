{
  "name": "post-banner-demo",
  "version": "0.1.0",
  "private": true,
  "description": "Accessible <post-banner> Web Component (Stencil, Shadow DOM, design tokens) with Storybook interaction and a11y tests.",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "files": [
    "dist/",
    "loader/"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "stencil build --docs",
    "build:watch": "stencil build --docs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.storybook.json",
    "check:contrast": "node scripts/check-contrast.mjs",
    "prestorybook": "npm run build",
    "storybook": "storybook dev -p 6006",
    "prestorybook:build": "npm run build",
    "storybook:build": "storybook build",
    "pretest": "npm run build",
    "test": "vitest run",
    "test:stories": "vitest run --project=storybook",
    "test:smoke": "vitest run --project=smoke",
    "example": "http-server . -p 8080 -a 127.0.0.1 -o /examples/plain-html/"
  },
  "dependencies": {
    "@stencil/core": "^4.45.2"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/web-components-vite": "^10.6.2",
    "@testing-library/dom": "^10.4.2",
    "@types/node": "^26.6.5",
    "@vitest/browser-playwright": "^5.0.4",
    "http-server": "^14.1.1",
    "lit": "^3.3.3",
    "playwright": "^1.64.0",
    "shadow-dom-testing-library": "^1.14.2",
    "storybook": "^10.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
